    local function paintOverlay(overlay, target, root, color, text, withHighlight)
        overlay.billboard.Adornee = root
        overlay.label.TextColor3, overlay.label.Text = color, text
        if withHighlight then
            if not overlay.highlight then
                overlay.highlight = new("Highlight", {
                    Name = "BTB_ESP", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    FillTransparency = 0.7, OutlineTransparency = 0,
                }, effects)
            end
            overlay.highlight.Adornee = target
            overlay.highlight.FillColor, overlay.highlight.OutlineColor = color, color
        elseif overlay.highlight then
            overlay.highlight:Destroy(); overlay.highlight = nil
        end
    end
    local function updateESP(context)
        local _, _, myRoot = body(me)
        local visible, candidates = {}, {}
        if state.ESP and myRoot then
            for _, player in ipairs(Players:GetPlayers()) do
                local character, humanoid, root = body(player)
                if character and relation(player, context) == "enemy" then
                    local distance = (root.Position - myRoot.Position).Magnitude
                    if distance <= state.ESPDistance then
                        table.insert(candidates, { player = player, character = character, humanoid = humanoid, root = root, distance = distance })
                    end
                end
            end
        end
        table.sort(candidates, function(a, b) return a.distance < b.distance end)
        for index, item in ipairs(candidates) do
            local player = item.player
            visible[player] = true
            if not overlays[player] then overlays[player] = makeOverlay("BTB_Enemy_" .. player.UserId) end
            local condition = item.character:GetAttribute("IsTrapped") and " | trapped"
                or item.character:GetAttribute("IsCarried") and " | carried" or ""
            local label = string.format("%s (@%s) · %s\n%d studs | %d HP%s", player.DisplayName, player.Name,
                role(player) or "Opponent", math.floor(item.distance), math.floor(item.humanoid.Health), condition)
            paintOverlay(overlays[player], item.character, item.character:FindFirstChild("Head") or item.root,
                state.ESPColor, label, index <= 20)
        end
        for player, overlay in pairs(overlays) do
            if not visible[player] then destroyOverlay(overlay); overlays[player] = nil end
        end
        local shownOvens, ovenCount = {}, 0
        if state.OvenESP and myRoot then
            if auto.ovenWorld ~= (context and context.world) or clock() >= (auto.nextOvenScan or 0) then auto.scanOvens(context) end
            for _, site in ipairs(auto.ovens) do
                    local object = site.object
                    local position, host = auto.ovenPosition(site), nil
                    if object:IsA("ProximityPrompt") then local _; _, host = promptPosition(object)
                    elseif object:IsA("BasePart") then host = object
                    else
                        for _, part in ipairs(object:GetDescendants()) do if part:IsA("BasePart") then host = part; break end end
                    end
                    if position and host and (position - myRoot.Position).Magnitude <= state.ESPDistance then
                        ovenCount += 1
                        shownOvens[object] = true
                        if not ovenOverlays[object] then ovenOverlays[object] = makeOverlay("BTB_Oven") end
                        local label = string.format("Oven / trap · %d studs%s", math.floor((position - myRoot.Position).Magnitude),
                            auto.siteOccupied(site, context) and " | occupied" or "")
                        paintOverlay(ovenOverlays[object], host, host, Color3.fromRGB(255, 173, 75), label, ovenCount <= 4)
                    end
            end
        end
        for prompt, overlay in pairs(ovenOverlays) do
            if not shownOvens[prompt] then destroyOverlay(overlay); ovenOverlays[prompt] = nil end
        end
    end
