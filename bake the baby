-- Paste the entire file into your client script runner. Right Shift toggles the UI.
-- Rayfield requires a client runtime with loadstring + game:HttpGet (not a normal LocalScript).
-- Game adapter derived from place 14567590300, supplied S13 BATHE DA BABY save.
-- Pickup extends the actual Catch prompt, not character physics. Server validation still applies.

local function createPanel(Rayfield, storage)
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Input = game:GetService("UserInputService")
    local PromptService = game:GetService("ProximityPromptService")
    local CollectionService = game:GetService("CollectionService")
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Lighting = game:GetService("Lighting")
    local me = Players.LocalPlayer
    assert(me, "Bake the Baby Admin Panel must run on the client.")
    local playerGui = me:WaitForChild("PlayerGui")
    local state = {
        AutoGrab = false, ExpandPickup = false, PickupRadius = 18, ShowPickupRange = false,
        AutoOven = false, TravelToOven = true, ReturnAfterOven = true, OvenESP = false,
        AutoRescue = false, RescueRadius = 12, BakerAlert = false, AlertRadius = 35,
        InstantPrompts = true, AutoPrompts = false, OnlyEPrompts = false, RepeatPrompts = false,
        ESP = true, ESPDistance = 3000,
        ESPColor = Color3.fromRGB(255, 85, 100),
        Speed = false, WalkSpeed = 32, Jump = false, JumpPower = 70,
        InfiniteJump = false, Noclip = false, Fly = false, FlySpeed = 60,
        Fullbright = false, CustomFOV = false, FOV = 90, PauseUnfocused = true,
        UseSavedSpot = false,
        AutoRun = false, QueueMode = "Any populated", JoinEmpty = false, HideDistance = 500,
    }
    local alive, focused = true, true
    local connections, characterConnections, characterParts = {}, {}, {}
    local prompts, overlays, ovenOverlays, ovenGuides = {}, {}, {}, {}
    local controls: { [string]: any } = {}
    local leases = { movement = {}, collision = {}, prompt = {}, lighting = {}, camera = {} }
    local interaction, rangeBall, flight, waypoint
    local selectedPlayer, selectedOven, playerDropdown, ovenDropdown
    local statusLabel, carryLabel, matchLabel, babyStatus, bakerStatus, detectionLabel
    local roleMode, playerSearch, playerScope = "Automatic", "", "All server players"
    local roleDropdown, speedInput
    local babyActionLabel, bakerActionLabel, lastReturn, rescueBatch
    local controlCopies, syncingControls = {}, false
    local lastStatus, statusText, statusUntil = "", "Ready", 0
    local lastJump, lastAlert, alertTarget = -math.huge, -math.huge, nil
    local nextAction, moveReadyAt = 0, 0
    local rosterSignature, promptSignature = "", ""
    local stats = { grabs = 0, deposits = 0, rescues = 0, prompts = 0, failedInputs = 0 }
    local clock = os.clock
    local destroyUI = Rayfield.Destroy
    local controller = { PlayerOptions = {}, OvenOptions = {} }
    local auto: { [string]: any } = { status = "Stopped", queues = {}, queueCooldowns = {}, queueLabels = {}, ovens = {}, ovenCooldowns = {}, nextScan = 0 }

    local function new(className, properties, parent)
        local object = Instance.new(className)
        for key, value in pairs(properties or {}) do object[key] = value end
        object.Parent = parent
        return object
    end
    local marker = new("ScreenGui", { Name = "BakeTheBabyAdminRuntime", ResetOnSpawn = false }, playerGui)
    local shutdownSignal = new("BindableFunction", { Name = "Shutdown" }, marker)
    local effects = new("Folder", { Name = "BakeTheBaby_LocalEffects" }, Workspace)

    local function connect(signal, callback, bag)
        local connection = signal:Connect(callback)
        table.insert(bag or connections, connection)
        return connection
    end
    local function disconnectAll(bag)
        for _, connection in ipairs(bag) do connection:Disconnect() end
        table.clear(bag)
    end
    local function writeProperty(bucket, object, property, value)
        local current = object[property]
        local record = bucket[object]
        if not record then record = {}; bucket[object] = record end
        local item = record[property]
        if not item then
            item = { original = current, applied = current }
            record[property] = item
        elseif current ~= item.applied then
            item.original = current -- Keep newer game-side values for restoration.
        end
        item.applied = value
        if current ~= value then object[property] = value end
    end
    local function restoreProperty(bucket, object, property)
        local record = bucket[object]
        local item = record and record[property]
        if not item then return end
        record[property] = nil
        pcall(function()
            if object[property] == item.applied then object[property] = item.original end
        end)
        if next(record) == nil then bucket[object] = nil end
    end
    local function restoreObject(bucket, object)
        local record = bucket[object]
        if not record then return end
        local keys = {}
        for key in pairs(record) do table.insert(keys, key) end
        for _, key in ipairs(keys) do restoreProperty(bucket, object, key) end
    end
    local function restoreAll(bucket)
        local objects = {}
        for object in pairs(bucket) do table.insert(objects, object) end
        for _, object in ipairs(objects) do restoreObject(bucket, object) end
    end
    local function setStatus(message, duration)
        statusText, statusUntil = message, clock() + (duration or 0)
    end
    local function notify(message)
        setStatus(message, 4)
        pcall(function()
            Rayfield:Notify({ Title = "Bake the Baby Admin Panel", Content = message, Duration = 4 })
        end)
    end
    local function path(root, ...)
        local node = root
        for _, name in ipairs({ ... }) do
            node = node and node:FindFirstChild(name)
        end
        return node
    end
    local function body(player)
        local character = player and player.Character
        if not character or not character:IsDescendantOf(Workspace) then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
            return character, humanoid, root
        end
        return nil
    end
    local function rosterRecord(player, roster)
        if not player or not roster then return nil end
        local named = roster:FindFirstChild(player.Name)
        if named then return named end
        for _, record in ipairs(roster:GetChildren()) do
            if tostring(record:GetAttribute("UserId")) == tostring(player.UserId) then return record end
        end
        return nil
    end
    local function matchContext()
        local id = me:GetAttribute("CurrentGameId")
        if id == false then return nil end
        if id == nil then
            -- The roster can arrive before CurrentGameId. Accept only one active membership.
            local active = path(ReplicatedStorage, "Game_Status", "Active_Games")
            for _, config in ipairs(active and active:GetChildren() or {}) do
                local record = rosterRecord(me, config:FindFirstChild("Players"))
                if config:GetAttribute("Game_Over") ~= true and record
                    and record:GetAttribute("In_Game") == true and record:GetAttribute("Alive") ~= false then
                    if id ~= nil then return nil end
                    id = config.Name
                end
            end
        end
        if id == nil then return nil end
        local key = tostring(id)
        local config = path(ReplicatedStorage, "Game_Status", "Active_Games", key)
        local world = path(Workspace, "Games_Folder", "Active_Games", key)
        return { id = key, config = config, roster = config and config:FindFirstChild("Players"), world = world }
    end
    local function participant(player, context)
        if not context then return nil end
        if context.config and context.config:GetAttribute("Game_Over") == true then return nil end
        local record = rosterRecord(player, context.roster)
        if record and (record:GetAttribute("In_Game") == false or record:GetAttribute("Alive") == false) then return nil end
        local id = player:GetAttribute("CurrentGameId")
        if id ~= nil and tostring(id) ~= context.id then return nil end
        if record then return record end
        -- Replication may expose CurrentGameId before the roster entry.
        if id ~= nil and player:GetAttribute("In_Game") ~= false and player:GetAttribute("Alive") ~= false then return player end
        return nil
    end
    local function role(player)
        local character = player and player.Character
        if not character or not character:IsDescendantOf(Workspace) then return nil end
        if player == me and roleMode ~= "Automatic" then return roleMode end
        -- Matches the game's ProximityPrompt_Visbility and Tutorial_Handler:
        -- truthy Character.IsBaby is a baby; false OR absent is an adult.
        -- Player.IsBaby may belong to a previous role and must not override the character.
        return character:GetAttribute("IsBaby") and "Baby" or "Baker"
    end
    local function roleText(player)
        local current = role(player)
        return current == "Baker" and "Baker / Adult" or current or "Waiting for character"
    end
    local function relation(player, context)
        if player == me then return "self" end
        local mine, theirs = participant(me, context), participant(player, context)
        if not mine or not theirs then return nil end
        local myTeam, theirTeam = mine:GetAttribute("Team"), theirs:GetAttribute("Team")
        if myTeam == nil then myTeam = me:GetAttribute("Team") end
        if theirTeam == nil then theirTeam = player:GetAttribute("Team") end
        if myTeam ~= nil and theirTeam ~= nil then
            return myTeam == theirTeam and "ally" or "enemy"
        end
        if me.Team and player.Team and not me.Neutral and not player.Neutral then
            return me.Team == player.Team and "ally" or "enemy"
        end
        local mineRole, theirRole = role(me), role(player)
        if mineRole and theirRole then return mineRole == theirRole and "ally" or "enemy" end
        return nil
    end
    local function carrying(character)
        local value = character and character:GetAttribute("Carries")
        return value ~= nil and value ~= false and value ~= 0 and value ~= "" and value ~= "0"
    end
    local function restrained(character)
        return character:GetAttribute("IsCarried") or character:GetAttribute("IsTrapped")
    end
    local function movable(character, humanoid, root)
        return character and not restrained(character) and not root.Anchored and not humanoid.Sit
    end
    local function characterOwner(object)
        local cursor = object.Parent
        while cursor and cursor ~= Workspace do
            if cursor:IsA("Model") then
                local player = Players:GetPlayerFromCharacter(cursor)
                if player then return player end
            end
            cursor = cursor.Parent
        end
        return nil
    end
    local function promptPosition(prompt)
        local host = prompt.Parent
        if not host then return nil end
        if host:IsA("Attachment") then return host.WorldPosition, host.Parent end
        if host:IsA("BasePart") then return host.Position, host end
        if host:IsA("Model") then return host:GetPivot().Position, host end
        return nil
    end
    local function words(value)
        return string.lower(tostring(value or "")):gsub("[^%w]", "")
    end
    local function includes(value, candidates)
        for _, candidate in ipairs(candidates) do
            if string.find(value, candidate, 1, true) then return true end
        end
        return false
    end
    local function trapContext(prompt, context)
        if not context or not context.world or not prompt:IsDescendantOf(context.world) then return false end
        local cursor = prompt
        while cursor and cursor ~= context.world do
            local name = words(cursor.Name)
            local metadata = words(cursor:GetAttribute("Name")) .. words(cursor:GetAttribute("Type"))
                .. words(cursor:GetAttribute("Title"))
            if name == "traps" or includes(name .. metadata, { "oven", "bathtub", "bathe" }) then return true end
            for guide in pairs(ovenGuides) do
                -- The game's Highlight handler associates a guide with Parent.Parent.
                if guide.Parent and cursor == guide.Parent.Parent then return true end
            end
            cursor = cursor.Parent
        end
        return includes(words(prompt:GetAttribute("Type")), { "oven", "trap", "bath" })
    end
    local function classify(prompt, context)
        if not prompt.Parent or not prompt:IsDescendantOf(Workspace) then return nil end
        local target = characterOwner(prompt)
        local action, name = words(prompt.ActionText), words(prompt.Name)
        local title, objectText = words(prompt:GetAttribute("Title")), words(prompt.ObjectText)
        if target then
            local character = body(target)
            if not character or role(target) ~= "Baby" then return nil end
            local side = relation(target, context)
            if side == "enemy" and (title == "catchbaby" or (name == "mom" and action == "catch")
                or includes(action, { "catchbaby", "pickupbaby", "grabbaby" })) then
                return "grab", target
            end
            if side == "ally" and character:GetAttribute("IsTrapped")
                and (name == "baby" or name == "all")
                and includes(action, { "rescue", "free", "save", "release" }) then
                return "rescue", target
            end
            return nil -- Never automate display mannequins or unrelated player prompts.
        end
        if not context or not context.world or not prompt:IsDescendantOf(context.world) then return nil end
        if selectedOven == prompt then return "oven" end
        if includes(action .. title, { "buy", "purchase", "donate" }) then return nil end
        local trap = trapContext(prompt, context) or includes(objectText .. title, { "oven", "bathtub", "bathe" })
        local frees = includes(action .. title, { "rescue", "free", "savebaby", "release", "removebaby", "untrap" })
        if trap and (name == "baby" or frees) then return "rescue" end
        if name == "baby" or frees then return nil end
        if includes(action, { "open", "close", "enter", "exit" }) then return nil end
        local deposits = includes(action .. title, { "cook", "bake", "bathe", "placebaby", "putbaby", "insertbaby", "depositbaby" })
        if deposits or (trap and (includes(action .. title, { "place", "put", "insert", "deposit", "trap" })
            or (name == "mom" and not includes(action, { "open", "close", "enter", "exit" })))) then return "oven" end
        return nil
    end

    local function releaseInput(returnHome)
        local active = interaction
        interaction = nil
        if active then
            if active.thread and coroutine.status(active.thread) ~= "dead" then
                pcall(task.cancel, active.thread)
            end
            if active.prompt then pcall(function() active.prompt:InputHoldEnd() end) end
            if returnHome and active.returnHome then
                local ok, err = pcall(active.returnHome)
                if not ok then warn("[Bake the Baby] Return failed: " .. tostring(err)) end
            end
        end
    end
    local function stopFlight()
        if not flight then return end
        local old = flight
        flight = nil
        old.velocity:Destroy()
        old.orientation:Destroy()
        old.attachment:Destroy()
        restoreProperty(leases.movement, old.humanoid, "PlatformStand")
        restoreProperty(leases.movement, old.humanoid, "AutoRotate")
        if old.root.Parent then
            old.root.AssemblyLinearVelocity = Vector3.zero
            old.root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    local function destroyOverlay(overlay)
        if not overlay then return end
        if overlay.highlight then overlay.highlight:Destroy() end
        overlay.billboard:Destroy()
    end
    local function clearOverlays(bucket)
        for key, overlay in pairs(bucket) do destroyOverlay(overlay); bucket[key] = nil end
    end
    local function cleanup()
        if not alive then return end
        alive = false
        releaseInput(true)
        if auto.stopHiding then auto.stopHiding(true) end
        if auto.leaveQueue then auto.leaveQueue(true) end
        disconnectAll(connections)
        disconnectAll(characterConnections)
        stopFlight()
        for _, bucket in pairs(leases) do restoreAll(bucket) end
        clearOverlays(overlays)
        clearOverlays(ovenOverlays)
        effects:Destroy()
        marker:Destroy()
        if storage.BakeTheBabyAdmin == controller then storage.BakeTheBabyAdmin = nil end
        pcall(destroyUI, Rayfield)
    end
    controller.Shutdown = cleanup
    storage.BakeTheBabyAdmin = controller
    shutdownSignal.OnInvoke = function() cleanup(); return true end
    Rayfield.Destroy = cleanup
    connect(marker.Destroying, cleanup)

    local function trackCharacter(character)
        releaseInput()
        if auto.stopHiding then auto.stopHiding(false) end
        auto.joining, auto.bounds = nil, nil
        lastReturn, rescueBatch = nil, nil
        state.UseSavedSpot = false
        if controls.UseSavedSpot then controls.UseSavedSpot:Set(false) end
        roleMode = "Automatic"
        if roleDropdown then roleDropdown:Set({ "Automatic" }) end
        waypoint = nil
        nextAction, moveReadyAt = clock() + 0.5, 0
        stopFlight()
        restoreAll(leases.movement)
        restoreAll(leases.collision)
        disconnectAll(characterConnections)
        table.clear(characterParts)
        if not character then return end
        connect(character:GetAttributeChangedSignal("IsBaby"), function()
            releaseInput(true); rescueBatch = nil
            if auto.stopHiding then auto.stopHiding(true) end
            roleMode = "Automatic"
            if roleDropdown then roleDropdown:Set({ "Automatic" }) end
            restoreAll(leases.prompt)
            clearOverlays(overlays)
            nextAction = clock() + 0.25
        end, characterConnections)
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then characterParts[object] = true end
        end
        connect(character.DescendantAdded, function(object)
            if object:IsA("BasePart") then characterParts[object] = true end
        end, characterConnections)
        connect(character.DescendantRemoving, function(object)
            restoreObject(leases.collision, object)
            characterParts[object] = nil
        end, characterConnections)
    end
    connect(me.CharacterAdded, trackCharacter)
    connect(me.CharacterRemoving, function() trackCharacter(nil) end)
    trackCharacter(me.Character)
    connect(me:GetAttributeChangedSignal("CurrentGameId"), function()
        releaseInput()
        if auto.stopHiding then auto.stopHiding(false) end
        auto.joining, auto.bounds = nil, nil
        lastReturn, rescueBatch = nil, nil
        state.UseSavedSpot = false
        if controls.UseSavedSpot then controls.UseSavedSpot:Set(false) end
        waypoint, selectedOven = nil, nil
        nextAction = clock() + 0.75
        restoreAll(leases.prompt)
        clearOverlays(overlays)
        clearOverlays(ovenOverlays)
        promptSignature, rosterSignature = "", ""
    end)
    connect(Input.WindowFocused, function() focused = true end)
    connect(Input.WindowFocusReleased, function()
        focused = false
        if state.PauseUnfocused and not state.AutoRun then releaseInput(true) end
    end)

    local function applyMovement()
        local character, humanoid, root = body(me)
        if not character or restrained(character) then
            stopFlight()
            restoreAll(leases.movement)
            restoreAll(leases.collision)
            return
        end
        if state.Speed then writeProperty(leases.movement, humanoid, "WalkSpeed", state.WalkSpeed)
        else restoreProperty(leases.movement, humanoid, "WalkSpeed") end
        if state.Jump then
            if humanoid.UseJumpPower then
                restoreProperty(leases.movement, humanoid, "JumpHeight")
                writeProperty(leases.movement, humanoid, "JumpPower", state.JumpPower)
            else
                restoreProperty(leases.movement, humanoid, "JumpPower")
                writeProperty(leases.movement, humanoid, "JumpHeight", state.JumpPower ^ 2 / (2 * math.max(Workspace.Gravity, 1)))
            end
        else
            restoreProperty(leases.movement, humanoid, "JumpPower")
            restoreProperty(leases.movement, humanoid, "JumpHeight")
        end
        if not state.Noclip then restoreAll(leases.collision) end
        if not state.Fly or auto.hide or not movable(character, humanoid, root) then stopFlight() end
    end
    local function updateFlight()
        local character, humanoid, root = body(me)
        if not state.Fly or auto.hide or not movable(character, humanoid, root) then stopFlight(); return end
        if flight and flight.root ~= root then stopFlight() end
        if not flight then
            local attachment = new("Attachment", { Name = "BTB_Flight" }, root)
            local velocity = new("LinearVelocity", {
                Name = "BTB_FlightVelocity", Attachment0 = attachment,
                RelativeTo = Enum.ActuatorRelativeTo.World, MaxForce = math.huge,
                VectorVelocity = Vector3.zero,
            }, root)
            local orientation = new("AlignOrientation", {
                Name = "BTB_FlightOrientation", Attachment0 = attachment,
                Mode = Enum.OrientationAlignmentMode.OneAttachment,
                MaxTorque = math.huge, Responsiveness = 25,
            }, root)
            flight = { attachment = attachment, velocity = velocity, orientation = orientation, root = root, humanoid = humanoid }
        end
        writeProperty(leases.movement, humanoid, "PlatformStand", true)
        writeProperty(leases.movement, humanoid, "AutoRotate", false)
        local camera = Workspace.CurrentCamera
        local direction = Vector3.zero
        if camera and (focused or not state.PauseUnfocused) and not Input:GetFocusedTextBox() then
            local function down(key) return Input:IsKeyDown(key) and 1 or 0 end
            local forward = down(Enum.KeyCode.W) - down(Enum.KeyCode.S)
            local right = down(Enum.KeyCode.D) - down(Enum.KeyCode.A)
            local up = down(Enum.KeyCode.Space) - math.max(down(Enum.KeyCode.LeftControl), down(Enum.KeyCode.RightControl))
            direction = camera.CFrame.LookVector * forward + camera.CFrame.RightVector * right + Vector3.yAxis * up
            if direction.Magnitude > 1 then direction = direction.Unit end
        end
        flight.velocity.VectorVelocity = direction * state.FlySpeed
        if camera then
            local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
            if look.Magnitude > 0.001 then flight.orientation.CFrame = CFrame.lookAt(Vector3.zero, look) end
        end
    end
    connect(RunService.PreSimulation, function()
        if not alive then return end
        local character = body(me)
        if state.Noclip and character and not restrained(character) then
            for part in pairs(characterParts) do
                if part.Parent then writeProperty(leases.collision, part, "CanCollide", false) end
            end
        end
        updateFlight()
    end)
    connect(Input.JumpRequest, function()
        if not alive or not state.InfiniteJump or state.Fly or Input:GetFocusedTextBox()
            or (state.PauseUnfocused and not focused) or clock() - lastJump < 0.16 then return end
        local character, humanoid, root = body(me)
        if not movable(character, humanoid, root) or humanoid.PlatformStand then return end
        lastJump = clock()
        local power = humanoid.UseJumpPower and humanoid.JumpPower
            or math.sqrt(2 * Workspace.Gravity * math.max(humanoid.JumpHeight, 0))
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, power, root.AssemblyLinearVelocity.Z)
    end)

    local function teleport(destination)
        local character, humanoid, root = body(me)
        if not movable(character, humanoid, root) then return false, "Character cannot move right now" end
        local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
        character:PivotTo(destination * rootToPivot)
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        return true
    end

    function auto.scanQueues()
        auto.nextScan = clock() + 0.75
        local helper = Workspace:FindFirstChild("DuelTeleportHelper")
        local names, rows = {}, {}
        for _, player in ipairs(Players:GetPlayers()) do names[tostring(player.UserId)] = "@" .. player.Name end
        for _, queue in ipairs(helper and helper:GetChildren() or {}) do
            local size = tonumber(queue:GetAttribute("TeamSize"))
            if size and size >= 1 and size <= 5 and size == math.floor(size) then
                local row = { object = queue, size = size, capacity = size * 2, count = 0, mine = false,
                    members = {}, slots = 0, destination = queue:GetAttribute("TeleportPivot") }
                local seen = {}
                for _, teamName in ipairs({ "Team1", "Team2" }) do
                    local team = queue:FindFirstChild(teamName)
                    for _, slot in ipairs(team and team:GetChildren() or {}) do
                        row.slots += 1
                        local id = tonumber(slot:GetAttribute("UserId"))
                        if id and id > 0 and not seen[id] then
                            seen[id], row.count = true, row.count + 1
                            row.mine = row.mine or id == me.UserId
                            table.insert(row.members, names[tostring(id)] or ("User " .. tostring(id)))
                        end
                    end
                end
                table.sort(row.members)
                table.insert(rows, row)
            end
        end
        table.sort(rows, function(a, b)
            local fillA, fillB = a.count / a.capacity, b.count / b.capacity
            if fillA ~= fillB then return fillA > fillB end
            return a.object.Name < b.object.Name
        end)
        auto.queues = rows
        for size, label in pairs(auto.queueLabels) do
            local lines = {}
            for _, row in ipairs(rows) do
                if row.size == size then
                    table.insert(lines, string.format("%s: %d/%d%s | %s", row.object.Name, row.count, row.capacity,
                        row.mine and " (you joined)" or row.count >= row.capacity and " (full)" or "",
                        #row.members > 0 and table.concat(row.members, ", ") or "empty"))
                end
            end
            label:Set(#lines > 0 and table.concat(lines, "\n") or (size .. "v" .. size .. ": no queue data loaded"))
        end
    end
    function auto.leaveQueue(returnHome)
        local joined = auto.joining
        auto.joining = nil
        if returnHome and joined and joined.character == me.Character and not matchContext() then teleport(joined.origin) end
    end
    function auto.queueTick()
        if clock() >= auto.nextScan then auto.scanQueues() end
        local _, _, root = body(me)
        if not root then auto.status = "Waiting for lobby character"; return end
        for _, row in ipairs(auto.queues) do
            if row.mine then auto.status = "Queued: " .. row.object.Name .. " | waiting for round start"; return end
        end
        if auto.joining then
            local attempt = auto.joining
            if clock() - attempt.started > 8 or not attempt.queue.Parent then
                auto.queueCooldowns[attempt.queue] = clock() + 15
                auto.leaveQueue(true)
                auto.status = "Queue entry not confirmed; trying another available queue"
                return
            end
            local refreshed = attempt.queue:GetAttribute("TeleportPivot")
            if tostring(typeof(refreshed)) == "CFrame" then attempt.destination = refreshed end
            if clock() >= attempt.nextMove and (root.Position - attempt.destination.Position).Magnitude > 3 then
                teleport(attempt.destination); attempt.nextMove = clock() + 2
            end
            auto.status = "Joining " .. attempt.queue.Name .. " | waiting for your slot to appear"
            return
        end
        for _, row in ipairs(auto.queues) do
            local mode = row.size .. "v" .. row.size
            if (state.QueueMode == "Any populated" or state.QueueMode == mode) and row.count < row.capacity
                and row.slots >= row.capacity and (row.count > 0 or state.JoinEmpty)
                and tostring(typeof(row.destination)) == "CFrame" and clock() >= (auto.queueCooldowns[row.object] or 0) then
                local origin = root.CFrame
                -- Same destination and ordinary character movement used by QuickJoinHandler.
                if teleport(row.destination) then
                    auto.joining = { queue = row.object, destination = row.destination, origin = origin,
                        character = me.Character, started = clock(), nextMove = clock() + 2 }
                    auto.status = "Joining " .. row.object.Name .. " (" .. row.count .. "/" .. row.capacity .. ")"
                else auto.status = "Waiting until your character can move" end
                return
            end
        end
        auto.status = "Waiting for a populated queue with space" .. (state.QueueMode ~= "Any populated" and (" | " .. state.QueueMode) or "")
    end
    function auto.stopHiding(returnHome)
        local hide = auto.hide
        auto.hide = nil
        if not hide then return false end
        hide.velocity:Destroy(); hide.attachment:Destroy()
        local context = matchContext()
        if returnHome and me.Character == hide.character and context and context.id == hide.gameId then teleport(hide.origin) end
