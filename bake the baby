    function auto.mapBounds(context)
        local map = context and context.world and context.world:FindFirstChild("Map")
        if not map then return nil end
        if auto.bounds and auto.bounds.map == map then return auto.bounds end
        local minimum, maximum
        for _, object in ipairs(map:GetDescendants()) do
            if object:IsA("BasePart") then
                local p, r = object.Position, object.Size.Magnitude * 0.5
                local low, high = p - Vector3.one * r, p + Vector3.one * r
                minimum = minimum and Vector3.new(math.min(minimum.X, low.X), math.min(minimum.Y, low.Y), math.min(minimum.Z, low.Z)) or low
                maximum = maximum and Vector3.new(math.max(maximum.X, high.X), math.max(maximum.Y, high.Y), math.max(maximum.Z, high.Z)) or high
            end
        end
        if not minimum then return nil end
        auto.bounds = { map = map, center = (minimum + maximum) * 0.5, radius = (maximum - minimum).Magnitude * 0.5 }
        return auto.bounds
    end
    function auto.playerDistance(point)
        local nearest = math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if player ~= me and root and root:IsA("BasePart") and root:IsDescendantOf(Workspace) then
                nearest = math.min(nearest, (root.Position - point).Magnitude)
            end
        end
        return nearest
    end
    function auto.hideTick(context)
        local character, humanoid, root = body(me)
        if not movable(character, humanoid, root) then auto.stopHiding(false); auto.status = "Baby: waiting until free to move"; return end
        local bounds = auto.mapBounds(context)
        if not bounds then auto.status = "Baby: waiting for map geometry"; return end
        local clearance = math.max(400, state.HideDistance)
        local hide = auto.hide
        if hide and (hide.character ~= character or hide.gameId ~= context.id) then auto.stopHiding(false); hide = nil end
        local point = hide and hide.point
        if not point or auto.playerDistance(point) < clearance then
            local radius = bounds.radius + clearance + 100
            local y = math.max(root.Position.Y, bounds.center.Y + 30, (Workspace.FallenPartsDestroyHeight or -500) + 100)
            point = nil
            for step = 0, 15 do
                local angle = step * math.pi / 8
                local candidate = Vector3.new(bounds.center.X + math.cos(angle) * radius, y, bounds.center.Z + math.sin(angle) * radius)
                if auto.playerDistance(candidate) >= clearance + 50 then point = candidate; break end
            end
            if not point then
                -- Outside every player's horizontal radius guarantees the requested separation.
                for _, player in ipairs(Players:GetPlayers()) do
                    local other = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if player ~= me and other and other:IsA("BasePart") then radius = math.max(radius, (other.Position - bounds.center).Magnitude + clearance + 100) end
                end
                point = Vector3.new(bounds.center.X + radius, y, bounds.center.Z)
            end
        end
        if not hide then
            local origin = root.CFrame
            stopFlight()
            local attachment = new("Attachment", { Name = "BTB_Hide" }, root)
            local velocity = new("LinearVelocity", { Name = "BTB_HideHover", Attachment0 = attachment,
                RelativeTo = Enum.ActuatorRelativeTo.World, MaxForce = math.huge, VectorVelocity = Vector3.zero }, root)
            hide = { character = character, gameId = context.id, origin = origin, point = point, attachment = attachment, velocity = velocity }
            auto.hide = hide
        end
        hide.point = point
        if (root.Position - point).Magnitude > 2 then teleport(CFrame.new(point)) end
        auto.status = string.format("Baby: hiding outside the map | nearest player %s studs", tostring(math.floor(auto.playerDistance(root.Position))))
    end
    local function besidePrompt(prompt, rangeOverride)
        local position = promptPosition(prompt)
        local _, _, root = body(me)
        if not position or not root then return nil end
        local away = (root.Position - position) * Vector3.new(1, 0, 1)
        if away.Magnitude < 0.01 then away = Vector3.zAxis end
        local range = rangeOverride or prompt.MaxActivationDistance
        local reach = math.max(0.5, math.min(2.5, range * 0.5))
        local location = position + away.Unit * reach
        local ray = RaycastParams.new()
        ray.FilterType = Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances = { me.Character, effects }
        local hit = Workspace:Raycast(location + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), ray)
        if hit and hit.Normal.Y > 0.5 then
            local _, humanoid = body(me)
            local height = math.max(2, humanoid.HipHeight + root.Size.Y * 0.5)
            local grounded = Vector3.new(location.X, hit.Position.Y + height, location.Z)
            if (grounded - position).Magnitude < range then location = grounded end
        end
        return CFrame.lookAt(location, Vector3.new(position.X, location.Y, position.Z))
    end

