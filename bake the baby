            local prompt = auto.sitePrompt(site, context)
            table.insert(lines, "[oven target] " .. site.object:GetFullName() .. " | " .. (prompt and ("prompt=" .. prompt:GetFullName()) or "no deposit prompt; approach and verify trap state"))
        end
        local rows = {}
        for prompt in pairs(prompts) do
            local kind = classify(prompt, context)
            if kind or (context and context.world and prompt:IsDescendantOf(context.world)) then
                table.insert(rows, string.format("[%s] %s | action=%s | object=%s | title=%s | type=%s | enabled=%s | range=%.1f | blocked=%s | disabled=%s",
                    kind or "unknown", prompt:GetFullName(), prompt.ActionText, prompt.ObjectText, tostring(prompt:GetAttribute("Title")),
                    tostring(prompt:GetAttribute("Type")), tostring(prompt.Enabled), prompt.MaxActivationDistance,
                    tostring(prompt:GetAttribute("Obstructed")), tostring(prompt:GetAttribute("Disabled"))))
            end
        end
        table.sort(rows)
        for i = 1, math.min(#rows, 60) do table.insert(lines, rows[i]) end
        if #rows == 0 then table.insert(lines, "No match interaction prompts are currently visible.") end
        return table.concat(lines, "\n")
    end
