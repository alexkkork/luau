        Misc:CreateSection("View and interaction")
        slider(Misc, "AlertRadius", "Baker alert distance", 10, 120, 5, "studs")
        slider(Misc, "ESPDistance", "ESP distance", 100, 5000, 100, "studs")
        Misc:CreateColorPicker({ Name = "Opponent ESP color", Color = state.ESPColor, Flag = "BTB3_ESPColor",
            Callback = function(color) if alive then state.ESPColor = color; updateESP(matchContext()) end end })
        toggle(Misc, "InstantPrompts", "Instant prompts [I]")
        toggle(Misc, "AutoPrompts", "Auto other proximity prompts [P]")
        toggle(Misc, "OnlyEPrompts", "Auto prompts: E key only")
        toggle(Misc, "RepeatPrompts", "Repeat prompts while in range")
        toggle(Misc, "CustomFOV", "Custom camera FOV")
        slider(Misc, "FOV", "Field of view", 50, 120, 1, "degrees")
        toggle(Misc, "PauseUnfocused", "Pause when window loses focus")
        Misc:CreateSection("Player teleport")
        Misc:CreateInput({ Name = "Search players", PlaceholderText = "Username or display name", RemoveTextAfterFocusLost = false,
            Callback = function(value)
                if not alive then return end
                playerSearch = string.lower(tostring(value)):match("^%s*(.-)%s*$")
                refreshDropdowns(matchContext(), true)
            end })
        Misc:CreateDropdown({ Name = "Player list scope", Options = { "All server players", "Current match only" },
            CurrentOption = { "All server players" }, MultipleOptions = false,
            Callback = function(options) playerScope = options[1]; refreshDropdowns(matchContext(), true) end })
        playerDropdown = Misc:CreateDropdown({
            Name = "Selected player", Options = { "None" }, CurrentOption = { "None" }, MultipleOptions = false,
            Callback = function(options) selectedPlayer = controller.PlayerOptions and controller.PlayerOptions[options[1]] end,
        })
        button(Misc, "Teleport beside selected player", function() teleportToPlayer(selectedPlayer) end)
        button(Misc, "Refresh players", function() refreshDropdowns(matchContext(), true) end)
        Misc:CreateSection("Shortcuts")
        for _, value in ipairs(shortcuts) do
            local shortcut = value
            Misc:CreateKeybind({ Name = shortcut.name .. " key", CurrentKeybind = shortcut.key, HoldToInteract = false,
                CallOnChange = true, Flag = "BTB4_" .. shortcut.id .. "Key",
                Callback = function(key)
                    if type(key) ~= "string" then return end
                    local ok, code = pcall(function() return Enum.KeyCode[key] end)
                    if ok and code ~= Enum.KeyCode.Unknown then shortcut.key = key end
                end })
        end
        Misc:CreateSection("Diagnostics")
        roleDropdown = Misc:CreateDropdown({
            Name = "Your role", Options = { "Automatic", "Baby", "Baker / Adult" }, CurrentOption = { "Automatic" }, MultipleOptions = false,
            Callback = function(options)
                local selected = options[1]
                roleMode = selected == "Baby" and "Baby" or selected == "Baker / Adult" and "Baker" or "Automatic"
                releaseInput(true); rescueBatch = nil; restoreAll(leases.prompt)
                syncPrompts(matchContext()); updateESP(matchContext()); updateRange()
            end,
        })
        button(Misc, "Print interaction diagnostics", function() print(diagnostics()); notify("Details printed to the console") end)
        button(Misc, "Copy interaction diagnostics", function()
            if type(setclipboard) == "function" then setclipboard(diagnostics()); notify("Diagnostics copied")
            else print(diagnostics()); notify("Diagnostics printed to console") end
        end)
        refreshDropdowns(matchContext(), true)
        pcall(function() Rayfield:LoadConfiguration() end)
        notify("Extra tools added below")
    end)
    button(Misc, "Turn off all features", function()
        pauseAutomation()
        for key, value in pairs(state) do if type(value) == "boolean" and key ~= "PauseUnfocused" then setToggle(key, false) end end
        notify("Features off; original values restored")
    end)
    button(Misc, "Unload panel and restore everything", cleanup)
    Misc:CreateLabel("O: catch | R: save | L: oven | H: stop and return")
    Misc:CreateLabel("Right Shift: UI | F: speed | J: jump | N: noclip | G: fly")

    local function updateLabels(context)
        if not alive then return end
        local myRole = role(me) or "waiting"
        local roleLabel = "Your role: " .. roleText(me) .. " | " .. (roleMode == "Automatic" and "auto detected" or "manual selection")
        matchLabel:Set("Match: " .. (context and context.id or "lobby") .. " | " .. roleLabel)
        babyStatus:Set(roleLabel)
        bakerStatus:Set(roleLabel)
        local held = carrying(me.Character)
        local target = held and heldBaby(context)
        carryLabel:Set(held and ("Holding a baby: YES" .. (target and (" (@" .. target.Name .. ")") or "")) or "Holding a baby: no")
        local counts = { grab = 0, oven = 0, rescue = 0 }
        for prompt in pairs(prompts) do
            local kind = classify(prompt, context)
            if kind then counts[kind] += 1 end
        end
        if auto.ovenWorld ~= (context and context.world) or clock() >= (auto.nextOvenScan or 0) then auto.scanOvens(context) end
        if detectionLabel then detectionLabel:Set(string.format("Detected: %d pickup / %d ovens or traps / %d deposit / %d rescue prompts", counts.grab, #auto.ovens, counts.oven, counts.rescue)) end
        if auto.label then auto.label:Set(state.AutoRun and (interaction and ("Role: " .. roleText(me) .. " | " .. statusText) or auto.status) or "Stopped") end
        if clock() >= statusUntil and not interaction then
            if not context or not participant(me, context) then statusText = "No active match - movement and other prompts available"
            elseif myRole == "Baker" and held then
                statusText = state.AutoOven and (counts.oven > 0 and "Baby held — finding an available oven" or "Baby held — waiting for an oven prompt")
                    or "Baby held — auto oven is off"
            elseif myRole == "Baker" and state.AutoGrab then statusText = "Auto catch: waiting for an available enemy baby"
            elseif myRole == "Baby" and state.AutoRescue then statusText = "Auto save: waiting for a trapped teammate"
            else statusText = "Ready" end
        end
        if statusText ~= lastStatus then
            statusLabel:Set(statusText); babyActionLabel:Set(statusText); bakerActionLabel:Set(statusText); lastStatus = statusText
        end
    end
    local failedSubsystems = {}
    local function guarded(name, callback)
        if failedSubsystems[name] then return end
        local ok, err = xpcall(callback, debug.traceback)
        if not ok then
            failedSubsystems[name] = true
            warn("[Bake the Baby / " .. name .. "] " .. tostring(err))
            if name == "automation" then releaseInput(true) end
            notify(name .. " paused after an error; details are in the console")
        end
    end
    local fastTimer, viewTimer, slowTimer = 0, 0, 0
    connect(RunService.Heartbeat, function(dt)
        if not alive then return end
        fastTimer += dt; viewTimer += dt; slowTimer += dt
        local context = matchContext()
        if fastTimer >= 0.1 then
            fastTimer = 0
            guarded("movement", applyMovement)
            guarded("automation", function() syncPrompts(context); automationTick(context) end)
            updateRange()
        elseif interaction and interaction.chase and clock() >= interaction.nextMove then
            -- Follow at up to 20 Hz without increasing full scans or pickup retry frequency.
            guarded("automation", function() automationTick(context) end)
        end
        if viewTimer >= 0.2 then
            viewTimer = 0
            guarded("ESP", function() updateESP(context) end)
        end
        if slowTimer >= 0.75 then
            slowTimer = 0
            guarded("queue detection", auto.scanQueues)
            guarded("oven detection", refreshOvenGuides)
            guarded("view", updateView)
            guarded("status", function() updateLabels(context); refreshDropdowns(context); alertTick() end)
        end
    end)
    -- All controls exist before persisted values can invoke their callbacks.
    pcall(function() Rayfield:LoadConfiguration() end)
    refreshDropdowns(matchContext(), true)
    syncPrompts(matchContext())
    updateESP(matchContext())
    updateLabels(matchContext())
    notify("Ready - O: catch, R: save, L: oven. Each action returns you.")
    return controller
end

