    local function updateView()
        if state.Fullbright then
            for key, value in pairs({ Brightness = 2, ClockTime = 14, FogEnd = 100000,
                Ambient = Color3.fromRGB(200, 200, 200), OutdoorAmbient = Color3.fromRGB(200, 200, 200) }) do
                writeProperty(leases.lighting, Lighting, key, value)
            end
        else restoreAll(leases.lighting) end
        local camera = Workspace.CurrentCamera
        local stale = {}
        for old in pairs(leases.camera) do if old ~= camera or not state.CustomFOV then table.insert(stale, old) end end
        for _, old in ipairs(stale) do restoreObject(leases.camera, old) end
