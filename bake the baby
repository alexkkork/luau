    local function nearestPlayer(wantedRole, wantedSide)
        local context, _, _, myRoot = matchContext(), body(me)
        if not myRoot then return nil end
        local best, distance = nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            local _, _, root = body(player)
            if root and relation(player, context) == wantedSide and (not wantedRole or role(player) == wantedRole) then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < distance then best, distance = player, d end
            end
        end
        return best, distance
    end
    local function teleportToPlayer(player)
        if not player or player == me or player.Parent ~= Players then notify("Select a player who is still in the server"); return end
        local _, _, root = body(player)
        if not root then notify("Target is not alive or streamed in"); return end
        releaseInput(true); nextAction = clock() + 0.6
        local ok, reason = teleport(root.CFrame * CFrame.new(3, 1, 0))
        notify(ok and ("Moved beside @" .. player.Name) or reason)
    end
    local function alertTick()
        if not state.BakerAlert or role(me) ~= "Baby" then alertTarget = nil; return end
        local player, distance = nearestPlayer("Baker", "enemy")
        if player and distance <= state.AlertRadius then
            if player ~= alertTarget and clock() - lastAlert >= 5 then
                notify(string.format("Baker nearby: @%s (%d studs)", player.Name, math.floor(distance)))
                lastAlert, alertTarget = clock(), player
            end
        else alertTarget = nil end
    end

    local function refreshDropdowns(context, force)
        local options, playerMap = { "None" }, {}
        for _, player in ipairs(Players:GetPlayers()) do
            local matchesSearch = playerSearch == "" or string.find(string.lower(player.Name), playerSearch, 1, true)
                or string.find(string.lower(player.DisplayName), playerSearch, 1, true)
            if player ~= me and matchesSearch and (playerScope == "All server players" or relation(player, context)) then
                local label = string.format("%s (@%s) [%s]", player.DisplayName, player.Name, role(player) or "Player")
                table.insert(options, label); playerMap[label] = player
            end
        end
        table.sort(options, function(a, b) if a == b then return false elseif a == "None" then return true elseif b == "None" then return false else return a < b end end)
        local signature = table.concat(options, "\n")
        controller.PlayerOptions = playerMap
        if playerDropdown and (force or signature ~= rosterSignature) then
            rosterSignature = signature
            playerDropdown:Refresh(options)
            local selected = "None"
            for label, player in pairs(playerMap) do if player == selectedPlayer then selected = label end end
            playerDropdown:Set({ selected })
        end
        local ovenOptions, ovenMap = { "Automatic detection" }, {}
        if context and context.world then
            for prompt in pairs(prompts) do
                if prompt:IsDescendantOf(context.world) and not characterOwner(prompt)
                    and not includes(words(prompt.ActionText), { "buy", "purchase", "donate" }) then
                    local relative = prompt:GetFullName():sub(#context.world:GetFullName() + 2)
                    local base = string.format("%s | %s", relative, prompt.ActionText)
                    local label, duplicate = base, 1
                    while ovenMap[label] do duplicate += 1; label = base .. " [" .. duplicate .. "]" end
                    ovenMap[label] = prompt; table.insert(ovenOptions, label)
                end
            end
        end
        table.sort(ovenOptions, function(a, b)
            if a == b then return false elseif a == "Automatic detection" then return true elseif b == "Automatic detection" then return false else return a < b end
        end)
        controller.OvenOptions = ovenMap
        local ovenSignature = table.concat(ovenOptions, "\n")
        if ovenDropdown and (force or ovenSignature ~= promptSignature) then
            promptSignature = ovenSignature
            ovenDropdown:Refresh(ovenOptions)
            local selected = "Automatic detection"
            for label, prompt in pairs(ovenMap) do if prompt == selectedOven then selected = label end end
            ovenDropdown:Set({ selected })
        end
    end
