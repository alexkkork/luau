    local function otherPrompt(prompt, context)
        if not prompt.Parent or prompt:GetAttribute("PlayerToolsIgnore") == true
            or characterOwner(prompt) or classify(prompt, context) then return false end
        local name, action = words(prompt.Name), words(prompt.ActionText)
        if includes(action, { "buy", "purchase", "donate", "catch", "rescue", "release", "baby" }) then return false end
        if name == "mom" and role(me) ~= "Baker" or name == "baby" and role(me) ~= "Baby" then return false end
        local activeWorlds = path(Workspace, "Games_Folder", "Active_Games")
        if activeWorlds and prompt:IsDescendantOf(activeWorlds)
            and (not context or not context.world or not prompt:IsDescendantOf(context.world)) then return false end
        if trapContext(prompt, context) then return false end
        return true
    end
    local function syncPrompts(context)
        local _, _, root = body(me)
        for prompt, promptRecord in pairs(prompts) do
            local kind = classify(prompt, context)
            local relevant = (kind == "grab" or kind == "oven") and role(me) == "Baker"
                or kind == "rescue" and role(me) == "Baby"
            if (relevant or otherPrompt(prompt, context)) and state.InstantPrompts
                and prompt:GetAttribute("PlayerToolsIgnore") ~= true then writeProperty(leases.prompt, prompt, "HoldDuration", 0)
            else restoreProperty(leases.prompt, prompt, "HoldDuration") end
            if kind == "grab" and role(me) == "Baker" and state.ExpandPickup then
                local record = leases.prompt[prompt]
                local item = record and record.MaxActivationDistance
                local original = item and item.original or prompt.MaxActivationDistance
                if item and prompt.MaxActivationDistance ~= item.applied then original = prompt.MaxActivationDistance end
                writeProperty(leases.prompt, prompt, "MaxActivationDistance", math.max(original, state.PickupRadius))
            else restoreProperty(leases.prompt, prompt, "MaxActivationDistance") end
            local position = promptPosition(prompt)
            if not root or not position or (root.Position - position).Magnitude > prompt.MaxActivationDistance then
                promptRecord.completed = false
            end
        end
    end
    local function usable(prompt, context, maxDistance, ignoreDistance, outsideMatch, planningTravel)
        local character, _, root = body(me)
        if not character or (not outsideMatch and not participant(me, context)) or restrained(character)
            or character:GetAttribute("CantUseProximities") or character:GetAttribute("Server_CantUseProximities")
            or not PromptService.Enabled or not prompt.Parent
            or (not prompt.Enabled and not planningTravel)
            or prompt:GetAttribute("PlayerToolsIgnore") == true
            or prompt:GetAttribute("Disabled") or (prompt:GetAttribute("Obstructed") and not planningTravel)
            or prompt:GetAttribute("Exclude") == me.Name then return nil end
        local position, host = promptPosition(prompt)
        if not position then return nil end
        local distance = (root.Position - position).Magnitude
        if ignoreDistance then return distance end
        if distance > math.min(maxDistance or math.huge, prompt.MaxActivationDistance) then return nil end
        if prompt.RequiresLineOfSight then
            local camera = Workspace.CurrentCamera
            if not camera then return nil end
            local ray = RaycastParams.new()
            ray.FilterType = Enum.RaycastFilterType.Exclude
            ray.FilterDescendantsInstances = { character, effects }
            local hit = Workspace:Raycast(camera.CFrame.Position, position - camera.CFrame.Position, ray)
            if hit and hit.Instance ~= host and not hit.Instance:IsDescendantOf(host) then return nil end
        end
        return distance
    end
    local trappedNear
    local function nearestPrompt(kind, context, maxDistance, ignoreDistance, planningTravel, allowedTargets)
        local best, bestTarget, distance = nil, nil, math.huge
        for prompt, record in pairs(prompts) do
            local found, target = classify(prompt, context)
            if found == "rescue" then target = target or trappedNear(prompt, context) end
            if found == kind and clock() >= record.nextTry
                and (kind ~= "oven" or selectedOven == nil or selectedOven == prompt) then
                local targetCharacter = target and target.Character
                local valid = kind ~= "grab" or (targetCharacter and not restrained(targetCharacter))
                if kind == "rescue" then valid = targetCharacter and targetCharacter:GetAttribute("IsTrapped") end
                if allowedTargets and not allowedTargets[target] then valid = false end
                if valid then
                    local d = usable(prompt, context, maxDistance, ignoreDistance, false, planningTravel)
                    if d and d < distance then best, bestTarget, distance = prompt, target, d end
                end
            end
        end
        return best, bestTarget, distance
    end

    local lastHeld
    local function heldBaby(context)
        local character = me.Character
        if not carrying(character) then lastHeld = nil; return nil end
        local value = character:GetAttribute("Carries")
        for _, player in ipairs(Players:GetPlayers()) do
            local baby = body(player)
            if baby and role(player) == "Baby" and relation(player, context) == "enemy"
                and baby:GetAttribute("IsCarried") then
                if player == lastHeld or value == player.Name or value == player.UserId
                    or value == tostring(player.UserId) then return player end
                for _, constraint in ipairs(baby:GetDescendants()) do
                    if constraint:IsA("RigidConstraint") then
                        local a, b = constraint.Attachment0, constraint.Attachment1
                        if (a and a:IsDescendantOf(character)) or (b and b:IsDescendantOf(character)) then return player end
                    end
                end
            end
        end
        return nil
    end
    trappedNear = function(prompt, context)
        local position = promptPosition(prompt)
        if not position then return nil end
        local best, distance = nil, 14
        for _, player in ipairs(Players:GetPlayers()) do
            local character, _, root = body(player)
            if character and role(player) == "Baby" and relation(player, context) == "ally"
                and character:GetAttribute("IsTrapped") then
                local d = (root.Position - position).Magnitude
                if d < distance then best, distance = player, d end
            end
        end
        return best
    end
    local function finishInteraction(success, message)
        local active = interaction
        if not active then return end
        local record = prompts[active.prompt]
        if record then
            record.failures = success and 0 or record.failures + 1
            record.nextTry = clock() + (success and 0.6 or math.min(8, 0.8 * 2 ^ math.min(record.failures, 4)))
            if active.kind == "prompt" and success then record.completed = true; record.nextTry = clock() + 1 end
        end
        if success then
            if active.kind == "grab" then stats.grabs += 1; lastHeld = active.target
            elseif active.kind == "oven" then stats.deposits += 1; lastHeld = nil
            elseif active.kind == "rescue" then stats.rescues += 1
            elseif active.kind == "prompt" then stats.prompts += 1 end
        else
            stats.failedInputs += 1
        end
        local shouldReturn = active.kind ~= "oven" or state.ReturnAfterOven
        releaseInput(shouldReturn)
        nextAction = clock() + 0.45
        local returnStatus = active.returned and " - returned" or active.returnHome and shouldReturn and " - return unavailable" or ""
        setStatus(message .. returnStatus, success and 1.3 or 2.5)
    end
    local function sendPromptInput(active)
        local prompt = active.prompt
        active.phase = "hold"
        active.holdEnds = clock() + math.max(0, prompt.HoldDuration) + 0.12
        active.deadline = active.holdEnds + 3
        if type(fireproximityprompt) == "function" then
            active.thread = task.spawn(function()
                local ok, err = pcall(fireproximityprompt, prompt)
                if alive and interaction == active then
                    active.sent, active.inputError = ok, not ok and tostring(err) or nil
                end
            end)
        else
            local ok, err = pcall(function() prompt:InputHoldBegin() end)
            if not ok then active.inputError = tostring(err) end
        end
    end
    local function rememberReturn(active, context)
        local character, humanoid, root = body(me)
        if not movable(character, humanoid, root) then return false end
        local origin = root.CFrame
        if state.UseSavedSpot and waypoint and waypoint.character == character and waypoint.gameId == (context and context.id) then
            origin = waypoint.cframe
        end
        lastReturn = { character = character, gameId = context and context.id, cframe = origin }
        active.returnHome = function()
            local current = matchContext()
            if active.character == me.Character and (current and current.id) == active.gameId then
                active.returned = teleport(origin)
                if active.returned then moveReadyAt = clock() + 0.35 end
            end
        end
        return true
    end
    local function resetCatchAttempt(active)
        if active.thread and coroutine.status(active.thread) ~= "dead" then pcall(task.cancel, active.thread) end
        if active.prompt then pcall(function() active.prompt:InputHoldEnd() end) end
        active.thread, active.sent, active.triggered, active.inputError = nil, nil, nil, nil
        active.phase, active.startAt = "approach", clock() + 0.4
    end
    local function tickCatch(active, context)
        local baby, _, babyRoot = body(active.target)
        if not baby or baby ~= active.targetCharacter or active.target.Parent ~= Players
            or role(me) ~= "Baker" or role(active.target) ~= "Baby" or relation(active.target, context) ~= "enemy"
            or baby:GetAttribute("IsTrapped") then
            finishInteraction(false, "Baby unavailable; catch stopped"); return
        end
        if baby:GetAttribute("IsCarried") then
            -- The baby's flag can replicate before our Carries acknowledgement.
            active.carriedAt = active.carriedAt or clock()
            if clock() - active.carriedAt > 2.5 then finishInteraction(false, "Baby is carried; your hold was not confirmed") end
            return
        end
        active.carriedAt = nil
        local prompt = active.prompt
        if not prompt or not prompt.Parent or not prompt:IsDescendantOf(baby) then
            resetCatchAttempt(active)
            prompt, active.prompt = nil, nil
            for _, object in ipairs(baby:GetDescendants()) do
                if object:IsA("ProximityPrompt") and classify(object, context) == "grab" then
                    cachePrompt(object)
                    prompt, active.prompt = object, object
                    break
                end
            end
        end
        local range = 4
        local settings = path(ReplicatedStorage, "General_Settings", "Catch_System", "Proximity")
        local configured = settings and settings:GetAttribute("Distance")
        if type(configured) == "number" and configured > 0 then range = configured end
        if prompt then
            local lease = leases.prompt[prompt]
            local original = lease and lease.MaxActivationDistance
            range = math.min(range, original and original.original or prompt.MaxActivationDistance)
        end
        if clock() >= active.nextMove then
            local destination = prompt and besidePrompt(prompt, range) or CFrame.new(babyRoot.Position + Vector3.new(2, 0, 0))
            if not destination or not teleport(destination) then finishInteraction(false, "Character cannot follow baby"); return end
            active.nextMove = clock() + 0.05
        end
        local ready = prompt and usable(prompt, context, range)
        if active.inputError then
            resetCatchAttempt(active)
            active.startAt = clock() + 1
        elseif active.phase == "hold" and (active.triggered or active.sent or clock() >= active.holdEnds) then
            pcall(function() prompt:InputHoldEnd() end)
            active.phase, active.deadline = "verify", clock() + 2
        elseif active.phase == "verify" and clock() >= active.deadline then
            resetCatchAttempt(active)
        end
        if active.phase == "approach" and clock() >= active.startAt and ready then
            active.attempts += 1
            sendPromptInput(active)
        end
        local reason = not prompt and "waiting for Catch prompt"
            or not PromptService.Enabled and "game prompts paused"
            or active.character:GetAttribute("Server_CantUseProximities") and "game has blocked interactions"
            or active.character:GetAttribute("CantUseProximities") and "character interactions paused"
            or prompt:GetAttribute("Disabled") and "Catch prompt disabled by game"
            or prompt:GetAttribute("Obstructed") and "Catch prompt obstructed"
            or not prompt.Enabled and "Catch prompt not enabled"
            or not ready and "waiting for prompt range / line of sight"
            or active.phase == "verify" and "waiting for holding confirmation" or "following and catching"
        setStatus(string.format("@%s: %s | attempt %d | H: stop", active.target.Name, reason, active.attempts))
    end
    local function startCatch(context)
        if interaction or clock() < nextAction or clock() < moveReadyAt or carrying(me.Character) then return false end
        local character, _, root = body(me)
        if not character or not participant(me, context) then return false end
        local target, distance = nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            local baby, _, babyRoot = body(player)
            if baby and role(player) == "Baby" and relation(player, context) == "enemy" and not restrained(baby) then
                local d = (root.Position - babyRoot.Position).Magnitude
                if d < distance then target, distance = player, d end
            end
        end
        if not target then return false end
        local active = { kind = "grab", chase = true, target = target, targetCharacter = target.Character,
            character = character, gameId = context.id, phase = "approach", startAt = clock() + 0.4,
            nextMove = 0, attempts = 0 }
        if not rememberReturn(active, context) then return false end
        interaction = active
        tickCatch(active, context)
        return interaction == active
    end
    local function startInteraction(prompt, kind: string, target, context, travel: boolean?)
        if interaction or clock() < nextAction or clock() < moveReadyAt
            or not usable(prompt, context, nil, travel == true, kind == "prompt", travel) then return false end
        if kind == "oven" and not carrying(me.Character) then return false end
        if kind == "grab" and carrying(me.Character) then return false end
        if kind == "rescue" then
            target = target or trappedNear(prompt, context)
            if not target then
                prompts[prompt].nextTry = clock() + 2
                return false
            end
        elseif kind == "oven" then target = heldBaby(context) end
        local active = {
            prompt = prompt, kind = kind, target = target,
            targetCharacter = target and target.Character,
            character = me.Character, gameId = context and context.id,
            phase = "hold", started = clock(), deadline = clock() + math.max(0, prompt.HoldDuration) + 3,
            holdEnds = clock() + math.max(0, prompt.HoldDuration) + 0.12,
        }
        if travel and not rememberReturn(active, context) then return false end
        interaction = active
        setStatus(kind == "grab" and "Grabbing nearby baby..." or kind == "oven" and "Placing held baby..."
            or kind == "prompt" and ("Using prompt: " .. prompt.ActionText) or "Rescuing teammate...")
        if travel then
            local record = leases.prompt[prompt]
            local saved = record and record.MaxActivationDistance
            local reach = saved and saved.original or prompt.MaxActivationDistance
            local settings = path(ReplicatedStorage, "General_Settings", "Catch_System", "Proximity")
            local configured = settings and settings:GetAttribute("Distance")
            if kind == "grab" and type(configured) == "number" and configured > 0 then reach = math.min(reach, configured) end
            local distance = usable(prompt, context, nil, travel == true, false, travel)
            if distance and (travel or distance > reach * 0.85) then
                local destination = besidePrompt(prompt, reach)
                local ok = destination and teleport(destination)
                if not ok then finishInteraction(false, "Could not reach the target"); return false end
                active.phase, active.startAt, active.deadline = "approach", clock() + 0.4, clock() + 2.4
                active.approachRange = reach
                setStatus(({ grab = "Catching baby...", rescue = "Saving baby from oven...", oven = "Putting baby in oven..." })[kind])
                return true
            end
        end
        sendPromptInput(active)
        return true
    end

    function auto.ovenPosition(site)
        local object = site.object
        if not object or not object.Parent then return nil end
        if object:IsA("ProximityPrompt") then return promptPosition(object) end
        for guide in pairs(ovenGuides) do
            if guide.Parent and guide.Parent.Parent == object and guide.Parent:IsA("BasePart") then return guide.Parent.Position end
        end
        for _, part in ipairs(object:GetDescendants()) do
            if part:IsA("BasePart") and includes(words(part.Name), { "touchdetector", "depositpoint", "trigger" }) then return part.Position end
        end
        if object:IsA("Model") then return object:GetPivot().Position end
        if object:IsA("BasePart") then return object.Position end
        return nil
    end
    function auto.scanOvens(context)
        auto.ovens, auto.ovenWorld, auto.nextOvenScan = {}, context and context.world, clock() + 0.75
        if not context or not context.world then return end
        local seen = {}
        local function add(object)
            if not object or seen[object] or not object:IsDescendantOf(context.world) or characterOwner(object) then return end
            local site = { object = object }
            if auto.ovenPosition(site) then seen[object] = true; table.insert(auto.ovens, site) end
        end
        local traps = path(context.world, "Map", "Resettable", "Traps")
        for _, trap in ipairs(traps and traps:GetChildren() or {}) do
            if trap:IsA("Model") or trap:IsA("BasePart") then add(trap) end
        end
        for guide in pairs(ovenGuides) do if guide.Parent then add(guide.Parent.Parent) end end
        for prompt in pairs(prompts) do
            if classify(prompt, context) == "oven" then
                local covered = false
                for object in pairs(seen) do if prompt:IsDescendantOf(object) then covered = true; break end end
                if not covered then add(prompt) end
            end
        end
    end
    function auto.sitePrompt(site, context)
        local best, distance = nil, math.huge
        local position = auto.ovenPosition(site)
        for prompt in pairs(prompts) do
            if (prompt == site.object or prompt:IsDescendantOf(site.object)) and classify(prompt, context) == "oven"
                and (not selectedOven or prompt == selectedOven) then
                local p = promptPosition(prompt)
                local d = p and position and (p - position).Magnitude or math.huge
                if d < distance then best, distance = prompt, d end
            end
        end
        return best
    end
    function auto.siteOccupied(site, context)
        local position = auto.ovenPosition(site)
        if not position then return true end
        for guide in pairs(ovenGuides) do
            if guide.Parent and guide.Parent.Parent == site.object and guide:GetAttribute("Blocked") then return true end
        end
        for _, player in ipairs(Players:GetPlayers()) do
            local baby, _, root = body(player)
            if baby and participant(player, context) and baby:GetAttribute("IsTrapped")
                and ((root.Position - position).Magnitude < 12 or baby:GetAttribute("TrapName") == site.object.Name) then return true end
        end
        return false
    end
    function auto.startDelivery(context, travel)
        if interaction or not carrying(me.Character) or clock() < nextAction or clock() < moveReadyAt then return false end
        if auto.ovenWorld ~= (context and context.world) or clock() >= (auto.nextOvenScan or 0) then auto.scanOvens(context) end
        local _, _, root = body(me)
        if not root then return false end
        local best, bestPrompt, distance = nil, nil, math.huge
        for _, site in ipairs(auto.ovens) do
            local position = auto.ovenPosition(site)
            local prompt = auto.sitePrompt(site, context)
            local allowed = not selectedOven or prompt == selectedOven
            if prompt then allowed = allowed and usable(prompt, context, nil, travel, false, travel) ~= nil
            elseif not travel then allowed = false end
            if position and allowed and clock() >= (auto.ovenCooldowns[site.object] or 0) and not auto.siteOccupied(site, context) then
                local d = (root.Position - position).Magnitude
                if (prompt and not bestPrompt) or ((prompt ~= nil) == (bestPrompt ~= nil) and d < distance) then
                    best, bestPrompt, distance = site, prompt, d
                end
            end
        end
        if not best then return false end
        local active = { kind = "oven", delivery = true, site = best, prompt = bestPrompt,
            character = me.Character, gameId = context.id, target = heldBaby(context),
            phase = "approach", started = clock(), startAt = clock() + 0.4, attempts = 0,
            nextMove = 0, travel = travel, trappedBefore = {} }
        active.targetCharacter = active.target and active.target.Character
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and player.Character:GetAttribute("IsTrapped") then active.trappedBefore[player] = true end
        end
        if travel and not rememberReturn(active, context) then return false end
        interaction = active
        auto.tickDelivery(active, context)
        return interaction == active
    end
    function auto.tickDelivery(active, context)
        local position = auto.ovenPosition(active.site)
        local holds = carrying(active.character)
        if not holds then
            local confirmed = false
            for _, player in ipairs(Players:GetPlayers()) do
                local baby, _, root = body(player)
                if baby and participant(player, context) and baby:GetAttribute("IsTrapped") and not active.trappedBefore[player]
                    and ((active.target == player and baby == active.targetCharacter)
                        or (not active.target and position and (root.Position - position).Magnitude < 30)) then confirmed = true end
            end
            if confirmed then finishInteraction(true, "Baby confirmed in oven"); return end
            active.carryLostAt = active.carryLostAt or clock()
            if clock() - active.carryLostAt > 2 then finishInteraction(false, "Carry ended; oven placement was not confirmed") end
            return
        end
        if not position or not context or not context.world or not active.site.object:IsDescendantOf(context.world) or role(me) ~= "Baker"
            or restrained(active.character) then finishInteraction(false, "Oven or character unavailable"); return end
        if clock() - active.started >= 7 then
            auto.ovenCooldowns[active.site.object] = clock() + 8
            finishInteraction(false, "Oven did not confirm placement; trying another oven"); return
        end
        local prompt = active.prompt
        if not prompt or not prompt.Parent then
            local discovered = auto.sitePrompt(active.site, context)
            if discovered ~= prompt then
                resetCatchAttempt(active)
                active.prompt, prompt = discovered, discovered
            end
        end
        if active.travel and clock() >= active.nextMove then
            local destination
            if prompt then destination = besidePrompt(prompt)
            else
                -- Runtime traps may use a touch trigger rather than a ProximityPrompt.
                -- Approach their real geometry and require IsTrapped confirmation; no remote guessed.
                local offset = active.attempts == 0 and Vector3.new(0, 0, 2) or active.attempts == 1 and Vector3.zero or Vector3.new(2, 0, 0)
                destination = CFrame.lookAt(position + offset, position + Vector3.new(0, 0, -1))
            end
            if not destination or not teleport(destination) then finishInteraction(false, "Could not reach oven"); return end
            active.nextMove = clock() + 0.3
        end
        if active.inputError then resetCatchAttempt(active); active.startAt = clock() + 1 end
        if prompt then
            if active.phase == "approach" and clock() >= active.startAt and usable(prompt, context) then
                active.attempts += 1; sendPromptInput(active)
            elseif active.phase == "hold" and (active.sent or active.triggered or clock() >= active.holdEnds) then
                pcall(function() prompt:InputHoldEnd() end)
                active.phase, active.deadline = "verify", clock() + 2
            elseif active.phase == "verify" and clock() >= active.deadline then resetCatchAttempt(active) end
            setStatus("Oven: " .. active.site.object.Name .. " | waiting for placement | attempt " .. active.attempts)
        else
            if clock() >= active.startAt then active.attempts = math.min(2, active.attempts + 1); active.startAt = clock() + 1.5 end
            setStatus("Oven: " .. active.site.object.Name .. " | approaching trap geometry; waiting for placement")
        end
    end
    connect(PromptService.PromptTriggered, function(prompt, player)
        if player ~= me then return end
        if interaction and interaction.prompt == prompt then interaction.triggered = true end
    end)
    local function tickInteraction(context)
        local active = interaction
        if not active then return end
        if (context and context.id) ~= active.gameId or me.Character ~= active.character or not body(me) then
            releaseInput(true); return
        end
        if active.delivery then auto.tickDelivery(active, context); return end
        local holds = carrying(active.character)
        local targetCharacter = active.targetCharacter
        local targetValid = active.target and active.target.Parent == Players and active.target.Character == targetCharacter
        if active.kind == "grab" and holds then
            finishInteraction(true, "Baby held — ready for oven"); return
        elseif active.kind == "oven" and not holds then
            if not targetCharacter or (targetValid and targetCharacter:GetAttribute("IsTrapped")) then
                finishInteraction(true, targetCharacter and "Baby placed in oven" or "Oven input finished; carry cleared")
                return
            end
        elseif active.kind == "rescue" and targetValid and not targetCharacter:GetAttribute("IsTrapped") then
            finishInteraction(true, "Teammate rescued"); return
        end
        if restrained(active.character) then
            finishInteraction(false, "Interaction paused while carried or trapped"); return
        end
        if active.chase then tickCatch(active, context); return end
        if active.inputError then
            finishInteraction(false, "Prompt input failed: " .. active.inputError); return
        end
        if active.phase ~= "verify" then
            if (active.kind == "grab" and (role(me) ~= "Baker" or not targetValid or relation(active.target, context) ~= "enemy"))
                or (active.kind == "rescue" and (role(me) ~= "Baby" or not targetValid or relation(active.target, context) ~= "ally"))
                or (active.kind == "oven" and role(me) ~= "Baker") then
                finishInteraction(false, "Role or target changed; interaction cancelled"); return
            end
            if active.kind == "grab" and targetCharacter and restrained(targetCharacter) then
                finishInteraction(false, "Target was already caught; interaction cancelled"); return
            end
        end
        if active.phase == "approach" then
            local distance = usable(active.prompt, context)
            if clock() >= active.startAt and distance and distance <= active.approachRange then
                sendPromptInput(active)
            elseif clock() >= active.deadline then
                finishInteraction(false, "Target unavailable after teleport")
            end
            return
        end
        if active.phase == "hold" then
            local valid = usable(active.prompt, context, nil, false, active.kind == "prompt")
            if active.kind == "prompt" and not otherPrompt(active.prompt, context) then valid = nil end
            if not valid and active.prompt.Parent and not active.triggered and not active.sent then
                finishInteraction(false, "Prompt moved out of reach or became unavailable"); return
            end
            if active.triggered or active.sent or clock() >= active.holdEnds then
                pcall(function() active.prompt:InputHoldEnd() end)
                if active.kind == "prompt" then
                    finishInteraction(true, "Prompt input sent: " .. active.prompt.ActionText); return
                end
                active.phase, active.deadline = "verify", clock() + 2
            end
        end
        if active.kind == "prompt" and active.phase == "verify" and (active.triggered or active.sent) then
            finishInteraction(true, "Prompt input sent"); return
        end
        if clock() >= active.deadline then
            finishInteraction(false, active.kind == "oven" and not holds
                and "Carry cleared; oven placement unconfirmed" or "No game confirmation; input cooldown active")
        end
    end
    local function otherPromptsTick(context)
        if not state.AutoPrompts or interaction then return end
        local best, distance = nil, math.huge
        for prompt, record in pairs(prompts) do
            if otherPrompt(prompt, context) and clock() >= record.nextTry and (state.RepeatPrompts or not record.completed)
                and (not state.OnlyEPrompts or prompt.KeyboardKeyCode == Enum.KeyCode.E) then
                local d = usable(prompt, context, nil, false, true)
                if d and d < distance then best, distance = prompt, d end
            end
        end
        if best then startInteraction(best, "prompt", nil, context) end
    end
    local function automationTick(context)
        if (state.PauseUnfocused and not focused and not state.AutoRun) or Input:GetFocusedTextBox() then
            if interaction and interaction.phase ~= "verify" then releaseInput(true) end
            if interaction then tickInteraction(context) end
            return
        end
        if interaction then tickInteraction(context); return end
        if clock() < nextAction or clock() < moveReadyAt then return end
        local character = body(me)
        if state.AutoRun then
            if not character then auto.stopHiding(false); auto.status = "Waiting for character"; return end
            if not participant(me, context) then
                auto.stopHiding(false)
                if context then auto.status = "Round ending or spectating; waiting for lobby"
                else auto.queueTick() end
                return
            end
            auto.joining = nil
            if role(me) == "Baby" then auto.hideTick(context); return end
            auto.stopHiding(true)
            auto.status = carrying(character) and "Baker: putting held baby into an oven" or "Baker: catching remaining enemy babies"
        end
        if not character or restrained(character) then return end
        if not participant(me, context) then otherPromptsTick(context); return end
        local myRole = role(me)
        if myRole == "Baker" and carrying(character) then
            if not (state.AutoOven or state.AutoRun) then otherPromptsTick(context); return end
            if not auto.startDelivery(context, state.AutoRun or state.TravelToOven) then
                if clock() >= statusUntil then setStatus("Holding baby — waiting for an available oven or trap in this match") end
                return
            end
        elseif myRole == "Baker" then
            if state.AutoGrab or state.AutoRun then
                if not startCatch(context) and state.AutoRun then auto.status = "Baker: no free enemy babies; waiting for round result" end
            end
        elseif myRole == "Baby" and (state.AutoRescue or rescueBatch) then
            local prompt, target = nearestPrompt("rescue", context, nil, true, true, rescueBatch)
            if prompt then
                if startInteraction(prompt, "rescue", target, context, true) and rescueBatch then rescueBatch[target] = nil end
            elseif rescueBatch then
                rescueBatch = nil
                setStatus("Rescue sweep finished", 3)
            end
        end
        otherPromptsTick(context)
    end

    local function requestAction(kind)
        local wanted = kind == "rescue" and "Baby" or "Baker"
        if role(me) ~= wanted then notify(wanted == "Baby" and "Use rescue while playing as a baby" or "Use this while playing as a baker"); return end
        if interaction or clock() < nextAction or clock() < moveReadyAt then notify("An action is already running; H stops and returns"); return end
        if kind == "grab" and carrying(me.Character) then notify("Already holding a baby"); return end
        if kind == "oven" and not carrying(me.Character) then notify("Catch a baby first"); return end
        local context = matchContext()
        if not participant(me, context) then notify("Join an active round first"); return end
        if kind == "grab" then
            if not startCatch(context) then notify("No available enemy baby in this match, or character cannot move") end
            return
        end
        if kind == "oven" then
            if not auto.startDelivery(context, true) then notify("No available oven or trap loaded in your match; copy detection report") end
            return
        end
        local prompt, target = nearestPrompt(kind, context, nil, true, true)
        if not prompt then
            notify(kind == "grab" and "No catchable baby found" or kind == "rescue" and "No trapped teammate with a rescue prompt" or "No usable oven found")
            return
        end
        if not startInteraction(prompt, kind, target, context, true) then notify("Character or prompt is unavailable right now") end
    end

    local function makeOverlay(name)
        local billboard = new("BillboardGui", {
            Name = name, Enabled = true, AlwaysOnTop = true,
            Size = UDim2.fromOffset(240, 44), StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
        }, effects)
        local label = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            TextColor3 = state.ESPColor, TextStrokeColor3 = Color3.new(0, 0, 0),
            TextStrokeTransparency = 0.2, Font = Enum.Font.GothamMedium, TextSize = 12,
