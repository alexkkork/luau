        for _, row in ipairs(auto.queues) do
            table.insert(lines, string.format("[queue] %s %d/%d%s | %s", row.object.Name, row.count, row.capacity,
                row.mine and " (you joined)" or "", table.concat(row.members, ", ")))
        end
