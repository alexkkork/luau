        button(Misc, "Speed -4", function() setSpeed(state.WalkSpeed - 4) end)
        button(Misc, "Speed +4", function() setSpeed(state.WalkSpeed + 4) end)
        for _, value in ipairs({ 16, 32, 64, 100 }) do
            local preset = value
            button(Misc, "Speed preset: " .. preset, function() setSpeed(preset) end)
        end
        button(Misc, "Restore game speed and jump", function()
            setToggle("Speed", false); setToggle("Jump", false); setToggle("InfiniteJump", false)
        end)
        Misc:CreateSection("Pickup and oven options")
        toggle(Misc, "ExpandPickup", "Pickup hitbox expander")
        slider(Misc, "PickupRadius", "Pickup radius", 4, 75, 1, "studs")
        toggle(Misc, "ShowPickupRange", "Show pickup area")
        toggle(Misc, "TravelToOven", "Auto oven can teleport")
        toggle(Misc, "ReturnAfterOven", "Return after automatic oven delivery")
        ovenDropdown = Misc:CreateDropdown({
            Name = "Oven prompt", Options = { "Automatic detection" }, CurrentOption = { "Automatic detection" }, MultipleOptions = false,
