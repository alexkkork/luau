    local function syncControls(key, value, origin)
        syncingControls = true
        for _, copy in ipairs(controlCopies[key] or {}) do if copy ~= origin then copy:Set(value) end end
        syncingControls = false
    end
    local function registerControl(key, control)
        if not controlCopies[key] then controlCopies[key] = {} end
        table.insert(controlCopies[key], control)
        controls[key] = controls[key] or control
        return control
    end
    local function changeToggle(key, value, origin)
        if not alive or syncingControls then return end
        if key == "UseSavedSpot" and value then
            local context = matchContext()
            if not waypoint or waypoint.character ~= me.Character or waypoint.gameId ~= (context and context.id) then
                value, origin = false, nil
                notify("Save a return position first")
            end
        end
        local changed = state[key] ~= value
        state[key] = value == true
        syncControls(key, state[key], origin)
        if key == "AutoRun" and changed then
            releaseInput(true)
            if not value then auto.stopHiding(true); auto.leaveQueue(true) end
            auto.status = value and "Starting; detecting lobby or current round" or "Stopped"
            auto.nextScan, nextAction = 0, clock() + 0.5
        end
        local affectsAction = interaction and ((key == "AutoGrab" and not value and interaction.kind == "grab")
            or (key == "AutoOven" and not value and interaction.kind == "oven")
            or (key == "AutoRescue" and not value and interaction.kind == "rescue")
            or ((key == "AutoPrompts" or key == "OnlyEPrompts") and interaction.kind == "prompt"))
        if changed and affectsAction then
            releaseInput(true); nextAction = clock() + 0.25
        end
        if key == "AutoRescue" and not value then rescueBatch = nil end
        if key == "Fly" and not value then stopFlight() end
        applyMovement(); syncPrompts(matchContext()); updateESP(matchContext()); updateView(); updateRange()
    end
    local function toggle(tab, key, name)
        local control
        control = tab:CreateToggle({
            Name = name, CurrentValue = state[key], Flag = not controls[key] and key ~= "UseSavedSpot" and key ~= "AutoRun" and ("BTB3_" .. key) or nil,
            Ext = controls[key] ~= nil,
            Callback = function(value) changeToggle(key, value, control) end,
        })
        return registerControl(key, control)
    end
    local function slider(tab, key, name, minimum, maximum, increment, suffix)
        local control
        control = tab:CreateSlider({
            Name = name, Range = { minimum, maximum }, Increment = increment, Suffix = suffix,
            CurrentValue = state[key], Flag = not controls[key] and ("BTB3_" .. key) or nil,
            Ext = controls[key] ~= nil,
            Callback = function(value)
                if not alive or syncingControls or type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return end
                state[key] = math.clamp(value, minimum, maximum)
                syncControls(key, state[key], control)
                if key == "WalkSpeed" and speedInput then speedInput:Set(tostring(state.WalkSpeed)) end
                applyMovement(); syncPrompts(matchContext()); updateView(); updateRange()
            end,
        })
        return registerControl(key, control)
    end
    local function button(tab, name, callback)
        tab:CreateButton({ Name = name, Callback = function()
            if not alive then return end
            local ok, err = xpcall(callback, debug.traceback)
            if not ok then warn("[Bake the Baby] " .. tostring(err)); notify("Action failed; details are in the console") end
        end })
    end
    local function setToggle(key, enabled)
        if controls[key] then controls[key]:Set(enabled) else changeToggle(key, enabled) end
    end
    local function pauseAutomation()
        local active = interaction
        local hadPosition = auto.hide ~= nil or auto.joining ~= nil
        releaseInput(true)
        setToggle("AutoRun", false)
        setToggle("AutoGrab", false); setToggle("AutoOven", false); setToggle("AutoRescue", false)
        setToggle("AutoPrompts", false)
        rescueBatch = nil
        local context = matchContext()
        if not active and not hadPosition and lastReturn and lastReturn.character == me.Character and lastReturn.gameId == (context and context.id) then
            teleport(lastReturn.cframe)
        end
        setStatus("Stopped and returned when possible", 3)
    end
    local function saveWaypoint()
        local character, _, root = body(me)
        if not root then notify("Wait for your character to spawn"); return end
        local context = matchContext()
        waypoint = { character = character, gameId = context and context.id, cframe = root.CFrame }
        setToggle("UseSavedSpot", true)
        notify("Return position saved")
    end
    local function returnToWaypoint()
        local context = matchContext()
        if not waypoint or waypoint.character ~= me.Character or waypoint.gameId ~= (context and context.id) then
            notify("Save a return position in this life first"); return
        end
        releaseInput(true); nextAction = clock() + 0.6
        local ok, reason = teleport(waypoint.cframe)
        notify(ok and "Returned to saved position" or reason)
    end

    local function setSpeed(value)
        local number = tonumber(value)
        if not number or number ~= number or math.abs(number) == math.huge then
            notify("Enter a speed from 1 to 250"); return
        end
        controls.WalkSpeed:Set(math.clamp(math.floor(number + 0.5), 1, 250))
        setToggle("Speed", true)
        if speedInput then speedInput:Set(tostring(state.WalkSpeed)) end
    end
    local shortcuts = {
        { id = "Catch", name = "Catch and return", key = "O", action = true, run = function() requestAction("grab") end },
        { id = "Rescue", name = "Save and return", key = "R", action = true, run = function() requestAction("rescue") end },
        { id = "Oven", name = "Oven and return", key = "L", action = true, run = function() requestAction("oven") end },
        { id = "Stop", name = "Stop and return", key = "H", action = true, run = pauseAutomation },
    }
    for _, entry in ipairs({ { "ESP", "K" }, { "InfiniteJump", "J" }, { "Noclip", "N" },
        { "AutoPrompts", "P" }, { "InstantPrompts", "I" }, { "Speed", "F" }, { "Fly", "G" } }) do
        local key = entry[1]
        table.insert(shortcuts, { id = key, name = "Toggle " .. key, key = entry[2], run = function() setToggle(key, not state[key]) end })
    end
    connect(Input.InputBegan, function(input, processed)
        if not alive or Input:GetFocusedTextBox() then return end
        for _, shortcut in ipairs(shortcuts) do
            if input.KeyCode == Enum.KeyCode[shortcut.key] then
                -- Camera/game bindings can consume O before InputBegan reaches us.
                -- Explicit actions still run; typing and ordinary consumed toggles do not.
                if processed and not shortcut.action then return end
                if state.PauseUnfocused and not focused and not shortcut.action then return end
                if shortcut.action then focused = true end
                local ok, err = xpcall(shortcut.run, debug.traceback)
                if not ok then warn("[Bake the Baby] " .. tostring(err)); notify("Action failed; check diagnostics") end
                break
            end
        end
    end)

    babyStatus = Babies:CreateLabel("Your role: waiting")
    button(Babies, "Save closest baby [R]", function() requestAction("rescue") end)
    toggle(Babies, "AutoRescue", "Auto save trapped babies")
    button(Babies, "Save all trapped babies once", function()
        if role(me) ~= "Baby" then notify("Use rescue while playing as a baby"); return end
        if interaction then notify("Finish the current action first, or press H"); return end
        local context = matchContext()
        local targets = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local character = body(player)
            if character and role(player) == "Baby" and relation(player, context) == "ally" and character:GetAttribute("IsTrapped") then targets[player] = true end
        end
        if not next(targets) then notify("No trapped teammates found"); return end
        rescueBatch = targets
        setStatus("Saving trapped teammates one at a time...", 2)
    end)
    Babies:CreateSection("Survival")
    toggle(Babies, "Noclip", "Noclip [N]")
    toggle(Babies, "InfiniteJump", "Infinite jump [J]")
    toggle(Babies, "BakerAlert", "Warn when a baker is near")
    button(Babies, "Stop and return [H]", pauseAutomation)
    babyActionLabel = Babies:CreateLabel("Rescue teleports to the oven, saves, then returns.")

    bakerStatus = Bakers:CreateLabel("Your role: waiting")
    button(Bakers, "Catch closest baby [O]", function() requestAction("grab") end)
    toggle(Bakers, "AutoOven", "Auto put held baby in oven")
    toggle(Bakers, "AutoGrab", "Auto catch babies")
    button(Bakers, "Put held baby in oven [L]", function() requestAction("oven") end)
    carryLabel = Bakers:CreateLabel("Holding: no baby")
    detectionLabel = Bakers:CreateLabel("Detected interaction prompts: waiting")
    button(Bakers, "Rescan ovens", function()
        for _, object in ipairs(Workspace:GetDescendants()) do cachePrompt(object) end
        refreshOvenGuides()
        local context = matchContext()
        auto.scanOvens(context)
        refreshDropdowns(context, true)
        local count = 0
        for prompt in pairs(prompts) do if classify(prompt, context) == "oven" then count += 1 end end
        notify(#auto.ovens > 0 and ("Found " .. #auto.ovens .. " ovens/traps and " .. count .. " deposit prompts") or "No oven targets loaded in this match. Copy detection report for details.")
    end)
    button(Bakers, "Copy detection report", function()
        if type(setclipboard) == "function" then setclipboard(diagnostics()); notify("Detection report copied")
        else print(diagnostics()); notify("Detection report printed to console") end
    end)
    Bakers:CreateSection("Tools")
    toggle(Bakers, "Noclip", "Noclip [N]")
    toggle(Bakers, "OvenESP", "Show ovens")
    button(Bakers, "Stop and return [H]", pauseAutomation)
    bakerActionLabel = Bakers:CreateLabel("O follows one baby until caught, then returns. H cancels.")

    Automation:CreateSection("Round automation")
    toggle(Automation, "AutoRun", "Run automation")
    Automation:CreateDropdown({ Name = "Game size", Options = { "Any populated", "1v1", "2v2", "3v3", "4v4", "5v5" },
        CurrentOption = { state.QueueMode }, MultipleOptions = false, Flag = "BTB42_QueueMode",
        Callback = function(options)
            local choice = options[1]
            if choice ~= "Any populated" and not table.find({ "1v1", "2v2", "3v3", "4v4", "5v5" }, choice) then return end
            if state.QueueMode ~= choice then auto.leaveQueue(true) end
            state.QueueMode, auto.nextScan = choice, 0
        end })
    toggle(Automation, "JoinEmpty", "Allow joining an empty queue")
    slider(Automation, "HideDistance", "Baby distance from all players", 400, 1500, 50, "studs")
    auto.label = Automation:CreateLabel("Stopped")
    Automation:CreateLabel("Baby: hide outside map and hover. Baker: catch, oven, repeat.")
    Automation:CreateLabel("Automation continues when unfocused. H stops it and returns when possible.")
    button(Automation, "Stop automation and return [H]", pauseAutomation)
    Automation:CreateSection("Who is waiting to play")
    for size = 1, 5 do auto.queueLabels[size] = Automation:CreateLabel(size .. "v" .. size .. ": loading") end
    button(Automation, "Refresh queues", auto.scanQueues)
    button(Automation, "Copy automation report", function()
        if type(setclipboard) == "function" then setclipboard(diagnostics()); notify("Automation report copied")
        else print(diagnostics()); notify("Automation report printed to console") end
    end)

    Misc:CreateSection("Movement")
    toggle(Misc, "Speed", "Speed [F]")
    slider(Misc, "WalkSpeed", "Walk speed", 1, 250, 1, "studs/s")
    toggle(Misc, "Jump", "Higher jump")
    slider(Misc, "JumpPower", "Jump power", 25, 250, 5, "power")
    toggle(Misc, "Fly", "Fly [G]")
    slider(Misc, "FlySpeed", "Flight speed", 10, 200, 5, "studs/s")
    toggle(Misc, "ESP", "Opponent ESP [K]")
    toggle(Misc, "Fullbright", "Fullbright")
    Misc:CreateSection("Return spot")
    button(Misc, "Save current position", saveWaypoint)
    toggle(Misc, "UseSavedSpot", "Return to saved spot after actions")
    button(Misc, "Return to saved position", returnToWaypoint)
    Misc:CreateSection("Panel")
    matchLabel = Misc:CreateLabel("Match: waiting")
    statusLabel = Misc:CreateLabel("Ready")
    local advancedShown = false
    button(Misc, "More tools and settings", function()
        if advancedShown then notify("Extra tools are below this button"); return end
        advancedShown = true
        Misc:CreateSection("Extra speed tools")
        speedInput = Misc:CreateInput({ Name = "Type walk speed (1-250)", CurrentValue = tostring(state.WalkSpeed),
            PlaceholderText = "32", RemoveTextAfterFocusLost = false, Ext = true,
